# Pramana Ghost daemon - paper execution only.
# Copy to .env on the VPS. Never commit real credentials.

# Shared state paths. The CLI, the ghost daemon and apps/pramana-ui all read these
# three variables, so setting them once keeps every component on one ledger.
# Defaults resolve to <repo root>/pramana_ledger.sqlite and <repo root>/pramana-proofs.
# PRAMANA_LEDGER_PATH=
# PRAMANA_PROOF_DIR=
PRAMANA_TENANT_ID=ghost

# Founder directives: capital, risk posture, allowed markets/asset classes, watchlist,
# position cap and free-text instructions. See deploy/founder-directives.example.json.
# PRAMANA_FOUNDER_DIRECTIVES_FILE=./founder-directives.json
# PRAMANA_FOUNDER_DIRECTIVES_JSON=
# Compose only: select the host file mounted at /app/directives.json.
# Use an absolute host path; a relative path resolves from deploy/.
# PRAMANA_DIRECTIVES_HOST_FILE=
# A sibling mount selects the sector map (target /app/pilot-sector-map.json).
# PRAMANA_SECTOR_MAP_HOST_FILE=
# Committed alternative universe: 10 large NSE equities plus the two metal ETFs
# (deploy/*.top10.json). The default stays the five-name example; switching is these
# three lines and nothing else. Every symbol still needs a Zerodha token mapping below.
# PRAMANA_DIRECTIVES_HOST_FILE=./founder-directives.top10.json
# PRAMANA_SECTOR_MAP_HOST_FILE=./pilot-sector-map.top10.json
# PRAMANA_NEWS_SYMBOL_ALIASES_JSON='<contents of deploy/news-symbol-aliases.top10.json on one line>'

# Real intelligence providers (missing providers abstain; readiness is never fabricated).
# PRAMANA_NEWS_RSS_URLS=https://example.com/markets.rss,https://example.com/world.rss
# Comma-separated. Each feed stands on its own: one that fails or serves an error page is
# logged by host and left out of that cycle while the others still answer, and its last
# good body stands in for up to 30 minutes. Every feed is downloaded once per five
# minutes, not once per instrument.
# Other names a symbol's news is published under. A per-instrument headline is matched by
# its ticker, and Indian copy rarely uses one: "Infosys" is not "INFY", "Gold ETFs" is not
# "GOLDBEES". Unset (the default) means the ticker is the only thing that matches.
# Each alias is matched as a WHOLE WORD, tolerating a plural "s", so "GOLD" reads
# "Gold ETFs" and not "Goldman Sachs", and "ITC" does not read "SWITCH". Aliases are 3-40
# characters of letters, digits, space, "&", "." and "-", at most 8 per symbol and 32
# symbols; anything outside that, or a value that is not parseable JSON, stops the daemon
# at boot instead of being dropped.
# An alias is YOUR assertion that a name refers to an instrument: nothing verifies it.
# Headlines matched this way carry the alias into the evidence block and onto the proof
# (matched_alias=...), so a reader can tell an asserted link from an observed one.
# PRAMANA_NEWS_SYMBOL_ALIASES_JSON={"INFY":["Infosys"],"GOLDBEES":["Gold ETF","Gold BeES","Gold price"],"SILVERBEES":["Silver ETF","Silver BeES","Silver price"]}
# FRED_API_KEY=
# Fundamentals (trailing P/E, debt/equity, operating margin, FCF yield) for the valuation agents.
# yahoo (default): Yahoo Finance quoteSummary, read-only, no key. Each watchlist/target symbol
# is fetched at most every 6 hours; the agents abstain unless all four ratios come back.
# none: no provider; the valuation agents abstain.
# PRAMANA_FUNDAMENTALS_PROVIDER=yahoo
# India context the macro snapshot carries beside FRED's core series, read by the Indian
# equities specialist for single names only (a stressed tape is a headwind, a large foreign
# outflow more so) and shown to the consensus model. Both are opt-in, both fail closed: an
# unavailable source leaves its series out of the snapshot, never a zero in it.
#   yahoo: India VIX and its previous close from Yahoo's ^INDIAVIX daily bars (no key).
#   nse:   NSE's provisional daily FII/FPI and DII net cash-market flows, rupees crore (no key).
# PRAMANA_INDIA_VIX_PROVIDER=yahoo
# PRAMANA_INDIA_FLOWS_PROVIDER=nse
# Daily bars for regime context (trend/volatility labels in every proof). yahoo (default): Yahoo
# Finance chart, read-only, one fetch per symbol per day; none: intraday-only regime.
# PRAMANA_DAILY_HISTORY_PROVIDER=yahoo

# Seconds an open position may go unpriceable before trading halts. A stop that cannot
# be evaluated is not enforced, so a dead feed leaves the book unprotected; the halt
# blocks new risk and requires `pramana resume` once the feed is confirmed healthy.
# PRAMANA_UNPROTECTED_HALT_SECONDS=120

# Cross-position risk controls (docs/PORTFOLIO_RISK_CONTROLS.md). Both are off by default
# and both only ever refuse more.
# Return history for the warden's correlation-adjusted gross and book expected-shortfall
# limits. daily: closed daily bars, one fetch per symbol per day. These limits FAIL CLOSED -
# once armed, history the engine cannot measure blocks new entries (never exits) - so turn
# them on deliberately. none (default): both limits stay unarmed.
# PRAMANA_BOOK_RISK_HISTORY=none
# Operator symbol-to-group mapping for the warden's group concentration limit. There is no
# security master here; absent, there is no grouping and the limit does not apply. A file
# path may be given instead with PRAMANA_SECTOR_MAP_FILE, or the same object may be set as
# the "sector_map" field of the founder directives.
# PRAMANA_SECTOR_MAP_JSON={"TCS": "IT_SERVICES", "INFY": "IT_SERVICES"}

# Declared corporate-action ex-dates, so a split or bonus is not read as a stop breach.
# JSON: {"schema": "pramana.corporate_actions.v1", "actions": [
#   {"symbol": "INFY", "ex_date": "2026-10-14", "kind": "split_1_5"}]}
# Undeclared actions are still caught by the price-step guard, so this file is a way to
# silence a known event, not the thing that prevents a fabricated loss.
# PRAMANA_CORPORATE_ACTIONS=
# Compose only: select the host file mounted at /app/corporate-actions.json (the container's
# PRAMANA_CORPORATE_ACTIONS is fixed to that path). Default: deploy/corporate-actions.example.json,
# which declares nothing. Copy it to deploy/corporate-actions.json (gitignored), add the
# ex-dates, then set this line.
# PRAMANA_CORPORATE_ACTIONS_HOST_FILE=./corporate-actions.json

# Overnight gap controls (docs/OVERNIGHT_GAP_POLICY.md). Both are off by default and both
# only ever refuse more. A stop is an intraday instrument: it cannot act on a price that
# never traded, so a position carried through a close takes the whole gap. Compose forwards
# both settings to the engine, so a value here arms the control at the next deploy; the
# pre-market check lists each one that is still off.
# Gross exposure, as a fraction of equity, the book may carry into a gap. 0.25 is the
# documented value: the 2% book stress tolerance over the -8% worst modelled gap, which is
# also five positions at the 5% single-trade cap. This limit FAILS CLOSED - once armed, an
# entry whose session position cannot be established (no venue, no usable timestamp) is
# refused, never exits - and it also refuses entries inside the last cadence interval
# before the close. Unset (default): unarmed, and the entry path is exactly as it was.
# PRAMANA_OVERNIGHT_GROSS_CAP=0.25
# Watches the price step each protected symbol makes across a session boundary. A step
# over the exchange band is either a corporate action or a catastrophic gap and the engine
# cannot tell which, so it alerts immediately, repeats every 30 minutes, and halts NEW RISK
# (never exits, and it never suppresses a stop) once one has gone a full trading session
# without an operator resolving it. session: armed. none (default): unarmed and silent.
# PRAMANA_OVERNIGHT_GAP_MONITOR=none

# Exchange holidays beyond the built-in calendar (NSE lunar-calendar closures).
# PRAMANA_HOLIDAYS_JSON={"INDIA": ["2026-03-26", "2026-11-09"]}

# Scheduled events that suppress NEW ENTRIES for a day (earnings, RBI policy, Fed
# decision, budget day, major data releases). Path to an operator-written JSON file;
# unset means no blackouts and the engine invents none. A file that exists but does not
# validate stops the daemon rather than silently vetoing nothing. Dates are exchange-local
# and exits are never blocked by a blackout. See docs/GATE2_BURN_IN.md.
# PRAMANA_EVENT_CALENDAR=./event-calendar.json
# Compose only: select the host file mounted at /app/event-calendar.json (the container's
# PRAMANA_EVENT_CALENDAR is fixed to that path). Default: deploy/event-calendar.example.json,
# which holds no events. Copy it to deploy/event-calendar.json (gitignored, so the deploy
# script's clean-tree check still passes), add the dates, then set this line. Relative
# paths resolve from deploy/. Format, dates in the calendar's timezone (NSE by default):
#   {"timezone": "Asia/Kolkata", "events": [
#     {"date": "2026-10-16", "category": "earnings", "symbol": "TRENT", "note": "Q2 results"},
#     {"date": "2026-10-01", "category": "rbi_policy"},
#     {"date": "2026-10-28", "through": "2026-10-29", "category": "fed_decision"}]}
# An event with a symbol blacks out that instrument; one without blacks out every
# instrument. An earnings event must carry its symbol. Exits are never blocked.
# PRAMANA_EVENT_CALENDAR_HOST_FILE=./event-calendar.json

# Founder alerts. Every dispatched alert is always appended as one JSON line to the
# durable alert log (default: alerts.jsonl next to the ledger), which needs no
# credentials and survives a container rebuild. Telegram adds optional push delivery
# on top; both values are required to enable it.
# PRAMANA_ALERT_LOG=
# PRAMANA_TELEGRAM_BOT_TOKEN=
# PRAMANA_TELEGRAM_CHAT_ID=

# Scheduled ledger backups (Compose `backup` service): how often it copies the ledger
# into /data/backups, and how many copies it keeps. An on-instance backup is not a
# backup - copy them off the host too (docs/VPS_GHOST_DEPLOYMENT.md).
# PRAMANA_BACKUP_INTERVAL_SECONDS=86400
# PRAMANA_BACKUP_KEEP=14

# Operator halt marker (default: next to the ledger). `pramana halt` / `pramana resume`.
# PRAMANA_HALT_FILE=

# HARD SAFETY GATE - the daemon refuses to boot if this is true.
TRADING_LIVE_MONEY_ACTIVE=false

# Research comparison only (quant_ai.research): the second candidate, "astra", is the
# OpenAI-backed side of the Claude-vs-Astra experiment. The trading engine never calls
# OpenAI - the research lab is offline by construction, touches no broker credential, no
# ledger and no cadence, and runs only when an operator invokes it. Leave it unset and
# `research_extensions compare` records `credential_missing` instead of a decision, which
# is a recorded failure rather than a gap. See docs/research-evaluation-lab.md.
# OPENAI_API_KEY=

# Required LLM + Zerodha market-data credentials.
ANTHROPIC_API_KEY=
# Daily (UTC) Anthropic spend caps for the ghost consensus; once reached, consensus degrades
# to NEUTRAL (PRESERVE_CAPITAL) until midnight UTC. A value of 0 or less disables that cap.
# The same limits apply separately to headline sentiment scoring (scope headline_sentiment);
# once that scope is spent, headlines fall back to the deterministic word-count scorer and
# every proof records which scorer produced each number.
# PRAMANA_AI_DAILY_CALL_LIMIT=500
# PRAMANA_AI_DAILY_TOKEN_LIMIT=2000000
# Where the daily counters live (default: ai-budget.sqlite next to the ledger).
# PRAMANA_AI_BUDGET_DB=
# Exploration budget, paper only. The consensus floor (55% average specialist confidence)
# turns every lower-conviction lean into a hold, and on a range-bound day that is every
# decision: 21 September 2026, the first twelve-name session, produced no directional
# decision for the quality report to score. With a budget, up to this many holds a day
# whose specialists lean BUY at or above the minimum confidence go through as probe
# entries sized at the fraction of equity, labelled exploration_probe in the proof and
# journaled with probe=1. Every gate still applies. 0 (default) is off. Documented
# values: 3 probes, 0.40 confidence, 0.01 of equity.
# PRAMANA_EXPLORATION_MAX_PER_DAY=3
# PRAMANA_EXPLORATION_MIN_CONFIDENCE=0.40
# PRAMANA_EXPLORATION_NOTIONAL_FRACTION=0.01
# Regime playbooks (on by default). The deterministic regime label each decision carries
# selects a playbook: trending_up=trend_following (plan floor, full size, probes allowed),
# ranging=range_trading (floor +0.05, 0.75x), trending_down=defensive (floor +0.10, 0.50x,
# no probes), high_volatility=crisis_standdown (floor +0.15, 0.35x, no probes), and
# insufficient_history or no read=plan_default (the plan floor and size; nothing tightens). Every
# BUY is also conviction-sized: half the plan quantity at the floor, all of it at 0.85
# confidence. Playbooks only tighten; "off" is the looser comparison setting.
# PRAMANA_REGIME_PLAYBOOKS=on
# Governed learning (on by default). Once per IST week the specialists are scored on how
# often their vote matched the 60-minute forward return over the last 10 sessions; a
# specialist with 30 or more scored votes gets a weight in 0.75-1.25 on its confidence
# (specialist-skill.json beside the decision-quality report names every decision used).
# "off" still writes the report and applies nothing. Post-mortems are built after each
# close and wait for `pramana post-mortem --approve YYYY-MM-DD`; nothing else learns alone.
# PRAMANA_SPECIALIST_REWEIGHTING=on
# Decision-quality report (calibration, hit rate, expectancy) rewritten after every cadence tick,
# and the session post-mortems the operator approves with `pramana post-mortem --approve DATE`.
# Defaults: decision-quality.json and post-mortems/ next to the ledger.
# PRAMANA_DECISION_QUALITY_REPORT=
# PRAMANA_POST_MORTEM_DIR=
# Missed-opportunity files: every hold of the session scored against its 60-minute forward
# return (missed above +1%, avoided below -1%), one JSON per IST date, plus one end-of-session
# alert. Unset means off; Compose forwards /data/missed-opportunities. Read it back with
# `python scripts/pilot_ops.py missed --database /data/pramana.db --tenant ghost [--date YYYY-MM-DD]`.
# PRAMANA_MISSED_OPPORTUNITY_DIR=
# Pre-open session plans: on the first cadence tick from 08:30 IST on a trading day the
# engine writes <dir>/<date>.json (regime and playbook per name, focus and stand-down lists,
# blackouts, yesterday's numbers, the probe budget, lessons and skill weights in force) and
# sends the morning brief. Default: session-plans/ next to the ledger. Read it back with
# `python scripts/pilot_ops.py plan --database /data/pramana.db [--date YYYY-MM-DD]`.
# PRAMANA_SESSION_PLAN_DIR=
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=

# Zerodha subscription map. Every watchlist symbol must appear as a mapped symbol,
# including the NSE metal ETFs if you keep them in the watchlist; an unmapped symbol is
# vetoed as missing market data. NO INSTRUMENT TOKENS ARE SUPPLIED HERE: look up the real
# numeric tokens for your own account in Kite's instrument dump
# (https://api.kite.trade/instruments, or kite.instruments("NSE")) and match on
# exchange=NSE plus the exact tradingsymbol. Never copy a token out of documentation.
# PRAMANA_ZERODHA_TOKENS_JSON=[<token_infy>, <token_goldbees>, <token_silverbees>]
# PRAMANA_ZERODHA_SYMBOLS_JSON={"<token_infy>": "INFY", "<token_goldbees>": "GOLDBEES"}
PRAMANA_ZERODHA_TOKENS_JSON=[]
PRAMANA_ZERODHA_SYMBOLS_JSON={}

# Full exact Zerodha instrument master (CSV/JSON) drives the available-universe panel.
# If unset, the collector calls Kite's read-only instruments() endpoint once per day and caches it.
# The master is metadata only; quote polling remains bounded by the watchlist.
# PRAMANA_ZERODHA_INSTRUMENTS_FILE=/data/zerodha-instruments.csv
# PRAMANA_ZERODHA_INSTRUMENTS_CACHE=/data/zerodha-instruments.json
# PRAMANA_INSTRUMENT_UNIVERSE_RECORDS=/data/instrument-universe.normalized.json

# Optional read-only India quote rows across NSE/BSE/NFO/BFO/CDS/BCD/MCX/NCDEX,
# MSEI and GIFT IFSC. Use exact broker symbols. Derivative rows also require
# contract, expiry, lotSize, tickSize and (for options) strike + optionType (CE/PE);
# generic labels are rejected. Paper execution remains disabled for these venues
# until separate contract qualification is reviewed.
# PRAMANA_MARKET_EXTRA_INSTRUMENTS_JSON=

# Instrument evaluated by the 10-minute Ghost cadence.
PRAMANA_TARGET_SYMBOL=INFY
PRAMANA_TARGET_MARKET=INDIA
PRAMANA_TARGET_ASSET_CLASS=EQUITY
PRAMANA_TARGET_CURRENCY=INR
PRAMANA_TARGET_EXCHANGE=NSE

# IBKR is opt-in. Leave false unless an IB Gateway/TWS endpoint is reachable from the container.
PRAMANA_IBKR_ENABLED=false
PRAMANA_IB_HOST=127.0.0.1
PRAMANA_IB_PORT=7497
PRAMANA_IB_CLIENT_ID=17
PRAMANA_IB_CONTRACTS_JSON=[]

# Private dashboard; use a randomly generated value with at least 32 characters.
PRAMANA_PILOT_MODE=true
PRAMANA_DASHBOARD_SECRET=
PRAMANA_PUBLIC_ORIGIN=http://localhost:3000
# PRAMANA_CONSOLE_DB=
# PRAMANA_MARKET_SNAPSHOT=
# PRAMANA_CHAT_MODEL=claude-sonnet-5
# Atlas chat calls allowed per tenant per UTC day (429 afterwards); 0 or less disables the cap.
# PRAMANA_CHAT_DAILY_LIMIT=200

# Reviewed deterministic research report for the dashboard (does not approve promotion).
# PRAMANA_RESEARCH_REPORT=
# Private research/event panels. For Compose, these are paths INSIDE the shared
# /data volume, not host paths. Publish actual reports before configuring them.
# PRAMANA_RESEARCH_LAB_REPORT=/data/research/comparison-001.json
# PRAMANA_PORTFOLIO_RESEARCH_REPORT=/data/research/portfolio-001.json
# PRAMANA_COMPANY_EVENTS_DB=/data/research/events.sqlite
# Include each selected report/database and its source inputs in recovery inventory.
# Optional override for scripts/india_paper_runtime.py state directory.
# PRAMANA_PILOT_RUNTIME=

# Separate high-entropy key for operator attestations; never use example/test keys.
# PRAMANA_REVIEW_SECRET=
# PRAMANA_REVIEW_DIR=
# Same pinned full Git SHA in engine and dashboard; see docs/RUNTIME_STRATEGY_MANIFEST.md
# PRAMANA_RELEASE_REVISION=
# PRAMANA_STRATEGY_CONFIG_SHA256=

# Optional private external broker observation; both values must be explicitly selected.
PRAMANA_EXTERNAL_ACCOUNT_SNAPSHOT=
PRAMANA_EXTERNAL_ACCOUNT_REF=
PRAMANA_BROKER_OBSERVATION=
PRAMANA_BROKER_ACCOUNT_REF=

# Select a broker observation journal instead of PRAMANA_BROKER_OBSERVATION.
# PRAMANA_BROKER_JOURNAL=/absolute/private/path/broker-history.sqlite

# Private historical paper/replay diagnostic, published by quant_ai.validation.run_comparison.
# PRAMANA_RUN_COMPARISON=/absolute/private/path/run-comparison.json

# Contract-bound daemon rollout requires a fresh/reviewed pilot and a separate durable OMS.
# Existing accounts are NOT migrated by changing these values. Keep legacy until reviewed.
PRAMANA_ORDER_IDENTITY_MODE=legacy_cash
# For an approved new bound_v1 Docker pilot, select e.g. /data/oms.sqlite.
PRAMANA_OMS_DB=
