# Canonical Pramana paths. These same three variables are read by the Python CLI
# (`pramana ...`) and the ghost daemon, so the UI and the engine always agree.
# Leave them unset to use the defaults, which resolve to the repository root:
#   <repo root>/pramana_ledger.sqlite  and  <repo root>/pramana-proofs
# PRAMANA_LEDGER_PATH=../../pramana_ledger.sqlite
# PRAMANA_PROOF_DIR=../../pramana-proofs
# PRAMANA_TENANT_ID=default
# Private, sanitized experiment snapshot generated by quant_ai.research.workspace_report.
# Explicitly configure this only for the authenticated workspace, never the public viewer.
# PRAMANA_RESEARCH_LAB_REPORT=/absolute/private/path/lab-workspace-report.json
# Sanitized read-only export combining comparison, simulation and company-event evidence.
# PRAMANA_RESEARCH_DASHBOARD_SNAPSHOT=/absolute/private/path/research-dashboard-snapshot.json
# Separate continuous portfolio journal snapshot for the authenticated Research screen.
# PRAMANA_PORTFOLIO_RESEARCH_REPORT=/absolute/private/path/portfolio-workspace-report.json

# Existing private NSE event database; no automatic creation or feed fetch.
PRAMANA_COMPANY_EVENTS_DB=

# Explicit private external broker observation and matching SHA-256 account reference
# PRAMANA_BROKER_OBSERVATION=/absolute/private/path/broker-observation.json
# PRAMANA_BROKER_ACCOUNT_REF=<accountRef from the selected capture>

# Select a broker observation journal instead of PRAMANA_BROKER_OBSERVATION.
# PRAMANA_BROKER_JOURNAL=/absolute/private/path/broker-history.sqlite

# Private historical paper/replay diagnostic, published by quant_ai.validation.run_comparison.
# PRAMANA_RUN_COMPARISON=/absolute/private/path/run-comparison.json
