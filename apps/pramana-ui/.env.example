# Canonical Pramana paths. These same three variables are read by the Python CLI
# (`pramana ...`) and the ghost daemon, so the UI and the engine always agree.
# Leave them unset to use the defaults, which resolve to the repository root:
#   <repo root>/pramana_ledger.sqlite  and  <repo root>/pramana-proofs
# PRAMANA_LEDGER_PATH=../../pramana_ledger.sqlite
# PRAMANA_PROOF_DIR=../../pramana-proofs
# PRAMANA_TENANT_ID=default
