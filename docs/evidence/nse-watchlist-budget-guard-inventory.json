{
  "schema": "pramana.watchlist_budget_guards.v1",
  "mutations": [
    {
      "id": "budget_paper_mode_required",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "_require(environ.get(\"TRADING_LIVE_MONEY_ACTIVE\", \"\").strip().lower() == \"false\",\n             \"budget_paper_mode_required\")",
      "new": "_require(True, 'budget_paper_mode_required')",
      "test": "tests/test_nse_watchlist_budget.py::test_paper_mode_must_be_explicit"
    },
    {
      "id": "budget_aware_clock_required",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "_require(isinstance(now, datetime) and now.utcoffset() is not None,\n             \"budget_aware_clock_required\")",
      "new": "_require(True, 'budget_aware_clock_required')",
      "test": "tests/test_nse_watchlist_budget.py::test_clock_requires_timezone"
    },
    {
      "id": "budget_window_invalid",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "_require(type(days) is int and 1 <= days <= MAX_DAYS, \"budget_window_invalid\")",
      "new": "_require(True, 'budget_window_invalid')",
      "test": "tests/test_nse_watchlist_budget.py::test_window_is_bounded_and_not_boolean"
    },
    {
      "id": "budget_limit_disabled_or_unusable",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "_require(0 < value <= SQLITE_MAX_INTEGER, \"budget_limit_disabled_or_unusable\")",
      "new": "_require(True, 'budget_limit_disabled_or_unusable')",
      "test": "tests/test_nse_watchlist_budget.py::test_disabled_unusable_or_malformed_limits_refuse"
    },
    {
      "id": "budget_regular_database_required",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "_require(stat.S_ISREG(info.st_mode), \"budget_regular_database_required\")",
      "new": "_require(True, 'budget_regular_database_required')",
      "test": "tests/test_nse_watchlist_budget.py::test_database_symlink_refused"
    },
    {
      "id": "budget_row_identity_invalid",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "_require(day in dates and scope in SCOPES, \"budget_row_identity_invalid\")",
      "new": "_require(True, 'budget_row_identity_invalid')",
      "test": "tests/test_nse_watchlist_budget.py::test_malformed_selected_date_refuses"
    },
    {
      "id": "budget_duplicate_or_excess_rows",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "_require((day, scope) not in observed, \"budget_duplicate_or_excess_rows\")",
      "new": "_require(True, 'budget_duplicate_or_excess_rows')",
      "test": "tests/test_nse_watchlist_budget.py::test_duplicate_or_excess_rows_refused[False]"
    },
    {
      "id": "budget_counters_invalid",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "_require(all(type(value) is int and 0 <= value <= SQLITE_MAX_INTEGER\n                     for value in (calls, inputs, outputs)), \"budget_counters_invalid\")",
      "new": "_require(True, 'budget_counters_invalid')",
      "test": "tests/test_nse_watchlist_budget.py::test_invalid_counters_refuse_without_echo"
    },
    {
      "id": "budget_table_unavailable",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "_require(table == [(\"table\",)], \"budget_table_unavailable\")",
      "new": "_require(True, 'budget_table_unavailable')",
      "test": "tests/test_nse_watchlist_budget.py::test_real_table_required_not_fabricated_view"
    },
    {
