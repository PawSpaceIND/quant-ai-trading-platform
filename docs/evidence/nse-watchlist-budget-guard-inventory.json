      "new": "_require(True, 'budget_row_limit')",
      "test": "tests/test_nse_watchlist_budget.py::test_duplicate_or_excess_rows_refused[True]"
    },
    {
      "id": "read_only_connection",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "\"?mode=ro\"",
      "new": "\"?mode=rw\"",
      "test": "tests/test_nse_watchlist_budget.py::test_database_connection_uses_read_only_mode"
    },
    {
      "id": "query_only",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "db.execute(\"PRAGMA query_only=ON\")",
      "new": "db.execute(\"PRAGMA query_only=OFF\")",
      "test": "tests/test_nse_watchlist_budget.py::test_query_only_untrusted_schema_transaction_and_work_limit"
    },
    {
      "id": "trusted_schema",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "db.execute(\"PRAGMA trusted_schema=OFF\")",
