      "test": "tests/test_nse_watchlist_budget.py::test_query_only_untrusted_schema_transaction_and_work_limit"
    },
    {
      "id": "snapshot_transaction",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "db.execute(\"BEGIN\")",
