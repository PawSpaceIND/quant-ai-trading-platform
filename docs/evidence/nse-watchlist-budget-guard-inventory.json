      "test": "tests/test_nse_watchlist_budget.py::test_query_only_untrusted_schema_transaction_and_work_limit"
    },
    {
      "id": "work_limit",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "return int(steps[0] > 100)",
      "new": "return 0",
      "test": "tests/test_nse_watchlist_budget.py::test_query_only_untrusted_schema_transaction_and_work_limit"
    },
    {
      "id": "bounded_returned_rows",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "\"ORDER BY day, scope LIMIT ?\"",
      "new": "\"ORDER BY day, scope LIMIT (? + 100)\"",
      "test": "tests/test_nse_watchlist_budget.py::test_sql_limits_rows_before_python_processing"
    },
    {
      "id": "redacted_arguments",
