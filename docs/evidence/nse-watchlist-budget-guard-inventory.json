      "new": "super().error(message)",
      "test": "tests/test_nse_watchlist_budget.py::test_cli_refuses_invalid_arguments_without_echo"
    },
    {
      "id": "redacted_limit_errors",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "raise BudgetObservationError(\"budget_limit_invalid\") from None",
      "new": "raise",
      "test": "tests/test_nse_watchlist_budget.py::test_disabled_unusable_or_malformed_limits_refuse"
    },
    {
      "id": "redacted_unexpected_errors",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "except Exception:  # noqa: BLE001 - diagnostic boundary must not echo private input\n        print(json.dumps({\"status\": \"observation_refused\", \"reason\": \"budget_observation_failed\"}))",
      "new": "except Exception as error:  # noqa: BLE001 - deliberately broken diagnostic for test\n        print(json.dumps({\"status\": \"observation_refused\", \"reason\": str(error)}))",
      "test": "tests/test_nse_watchlist_budget.py::test_cli_read_failure_details_redacted"
    },
    {
      "id": "missing_is_unknown",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "\"dayUTC\": day, \"scope\": scope, \"rowPresent\": False,\n                \"reservedLogicalCalls\": None,",
      "new": "\"dayUTC\": day, \"scope\": scope, \"rowPresent\": False,\n                \"reservedLogicalCalls\": 0,",
      "test": "tests/test_nse_watchlist_budget.py::test_missing_rows_are_unknown_not_zero"
    },
    {
      "id": "utc_budget_axis",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "current = now.astimezone(timezone.utc)",
      "new": "current = now",
      "test": "tests/test_nse_watchlist_budget.py::test_budget_day_remains_utc_across_india_midnight"
    },
    {
      "id": "separate_scopes_filter",
      "path": "scripts/inspect_watchlist_budget.py",
      "old": "\"WHERE day BETWEEN ? AND ? AND scope IN (?, ?) \"",
      "new": "\"WHERE day BETWEEN ? AND ? AND (? IS NOT NULL AND ? IS NOT NULL) \"",
      "test": "tests/test_nse_watchlist_budget.py::test_unrelated_scopes_and_old_dates_never_printed"
    }
  ]
}
